# ── Django ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# ── Database ───────────────────────────────────────────
POSTGRES_DB=scarlett
POSTGRES_USER=scarlett
POSTGRES_PASSWORD=scarlett
DATABASE_URL=postgres://scarlett:scarlett@db:5432/scarlett

# ── Redis (live chat) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email ──────────────────────────────────────────────
# Leave EMAIL_HOST empty to use the Mailpit dev inbox (http://localhost:8025).
# For Gmail, use an App Password (Google Account > Security > 2-Step Verification
# > App passwords) — never your normal password. Keep this file out of git.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Scarlett Embroidery <no-reply@sedigitizer.com>
STAFF_NOTIFY_EMAIL=orders@sedigitizer.com

# ── Initial admin (created by `make seed`) ─────────────
ADMIN_EMAIL=admin@sedigitizer.com
ADMIN_PASSWORD=admin12345

# ── Production only ────────────────────────────────────
SECURE_SSL_REDIRECT=False

# ── Host ports ─────────────────────────────────────────
# WEB_PORT is the dev server; HTTP_PORT is nginx in production (make prod-up).
WEB_PORT=8000
HTTP_PORT=80
POSTGRES_PORT=5432
MAILPIT_PORT=8025
