# ─────────────────────────────────────────────────────────────
# PRODUCTION settings. On the server: copy this file to `.env`
# (cp .env.production.example .env) and replace every CHANGE_ME.
# NEVER commit the real .env — it holds your passwords.
# ─────────────────────────────────────────────────────────────

# ── Domain (used by Caddy for the free HTTPS certificate; no https://, no www) ──
DOMAIN=yourdomain.com

# ── Django ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_long_random_string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_URL=https://yourdomain.com

# ── Database (the password must match in all three places) ──
POSTGRES_DB=scarlett
POSTGRES_USER=scarlett
POSTGRES_PASSWORD=CHANGE_ME_db_password
DATABASE_URL=postgres://scarlett:CHANGE_ME_db_password@db:5432/scarlett
CONN_MAX_AGE=60

# ── Redis (live chat) ──────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (real SMTP — Gmail needs an App Password) ────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@yourdomain.com
EMAIL_HOST_PASSWORD=CHANGE_ME_app_password
DEFAULT_FROM_EMAIL=Scarlett Embroidery <no-reply@yourdomain.com>
STAFF_NOTIFY_EMAIL=orders@yourdomain.com

# ── First admin (created once by `make prod-seed`) ─────
# Change the password in Console > Settings > My account after first login.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── HTTPS (Caddy provides the certificate; keep these on) ─
SECURE_SSL_REDIRECT=True
SECURE_COOKIES=True
# Start with 0; raise to 31536000 (1 year) once HTTPS is confirmed stable.
SECURE_HSTS_SECONDS=0
